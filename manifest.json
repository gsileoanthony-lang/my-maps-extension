{
  "manifest_version": 3,
  "name": "Maps Lead Scraper",
  "version": "1.0",
  "description": "Google Maps se data scrape karke CSV file mein save karta hai.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
